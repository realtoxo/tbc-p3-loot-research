# Generated documents. Collapsed in GitHub diffs so reviewers read the data
# change rather than the rendered output. Never hand-edit these; `just check`
# fails the build if you do.
docs/generated/**  linguist-generated=true

# Derived fact tables are machine-produced from research/.
data/facts/*.csv   linguist-generated=true

# Raw research artifacts are evidence, not source. Keep them out of language
# statistics but leave diffs readable.
research/**        linguist-vendored=true

# Keep CSV and YAML diffs line-based and readable.
*.csv  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
