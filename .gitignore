# Generated HTML output. Disposable; rebuild with `just build`, and publish it
# with `just publish`, which commits it to gh-pages without tracking it here.
/site/

# Derived analysis. Regenerable, and it embeds modelling choices that are not
# yet decided, so it is not committed while the project is gathering facts.
/data/derived/

# Never commit a vendored simulator checkout. Bootstrap it on demand.
/vendor/
**/wowsims-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node, only if a helper ever needs it
node_modules/

# OS and editor
.DS_Store
*.swp
.idea/
.vscode/

# Scratch work that is not evidence
/scratch/

# The wowsims simulator binary, installed by tools/install_wowsimcli.sh.
# Platform specific and 5 MB, so it is fetched rather than committed. The tag
# it was built from is recorded in vendor/wowsims/VERSION.
vendor/
